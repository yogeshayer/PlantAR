 import SwiftUI

struct InfoCardView: View {
    let part: PlantPart

    var body: some View {
        VStack(spacing: 8) {
            Text(part.name)
                .font(.headline)
                .foregroundColor(.white)

            Text(part.description)
                .font(.body)
                .foregroundColor(.white)
                .multilineTextAlignment(.center)
        }
        .padding()
        .frame(maxWidth: .infinity)
        .background(Color.black.opacity(0.75))
        .cornerRadius(12)
    }
}
